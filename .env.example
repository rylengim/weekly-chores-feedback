# Django settings module: local, test, staging, or production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-only-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Use a dedicated POSTGRES_DB with test settings.
POSTGRES_DB=weekly_chores
POSTGRES_USER=weekly_chores
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional. DJANGO_DEBUG recognizes true, 1, yes, and on.
DJANGO_DEBUG=true
# Optional. Console logging defaults to INFO.
DJANGO_LOG_LEVEL=INFO
